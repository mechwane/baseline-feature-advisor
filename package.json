{
	"name": "baseline-feature-advisor",
	"displayName": "AI-Powered Baseline Feature Advisor",
	"description": "Detect non-Baseline or unsafe web APIs, HTML attributes, and CSS features with instant AI-powered Quick Fixes.",
	"version": "2.0.0",
	"publisher": "Algma-Tech",
	"author": {
		"name": "Adam Adekanye Adewale (Algma Tech)",
		"email": "adamadekanye941@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mechwane/baseline-feature-advisor"
	},
	"icon": "adam.png",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Linters",
		"Programming Languages",
		"Other"
	],
	"keywords": [
		"web",
		"baseline",
		"compatibility",
		"api",
		"css",
		"html",
		"scanner",
		"ai",
		"gemini",
		"security"
	],
	"activationEvents": [
		"onLanguage:javascript",
		"onLanguage:javascriptreact",
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:html",
		"onLanguage:css"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "baselineAdvisor.scanFile",
				"title": "Scan File for Non-Baseline Features",
				"category": "Baseline Advisor"
			},
			{
				"command": "baselineAdvisor.scanWorkspace",
				"title": "Scan Workspace for Non-Baseline Features",
				"category": "Baseline Advisor"
			},
			{
				"command": "baselineAdvisor.askAIForFix",
				"title": "Get AI Baseline Fix",
				"category": "Baseline Advisor"
			}
		],
		"configuration": {
			"title": "Baseline Feature Advisor",
			"properties": {
				"baselineAdvisor.enableRealTimeScanning": {
					"type": "boolean",
					"default": true,
					"description": "Enable real-time scanning while typing"
				},
				"baselineAdvisor.targetBaseline": {
					"type": "string",
					"enum": [
						"widely",
						"newly"
					],
					"default": "widely",
					"description": "Minimum Baseline support level: 'widely' (30+ months cross-browser) or 'newly' (latest interoperable release)"
				},
				"baselineAdvisor.aiSuggestions": {
					"type": "boolean",
					"default": true,
					"description": "Enable AI-powered code suggestions and Quick Fixes"
				},
				"baselineAdvisor.aiProvider": {
					"type": "string",
					"enum": [
						"auto",
						"vscode-lm",
						"gemini",
						"openai"
					],
					"default": "auto",
					"description": "AI provider: 'auto' (uses configured API key or VS Code built-in AI), 'vscode-lm' (Copilot/built-in models), 'gemini', or 'openai'"
				},
				"baselineAdvisor.geminiApiKey": {
					"type": "string",
					"default": "",
					"description": "Google Gemini API Key for AI suggestions"
				},
				"baselineAdvisor.openaiApiKey": {
					"type": "string",
					"default": "",
					"description": "OpenAI API Key for AI suggestions"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.90.0"
	},
	"dependencies": {
		"typescript": "^5.6.0",
		"web-features": "latest"
	}
}